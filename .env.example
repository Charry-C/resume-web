# Set a long, random administrator password before starting the server.
ADMIN_PASSWORD=

# Optional for demo mode; required for recognizing uploaded resumes.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
QWEN_MODEL=qwen3.6-plus
DEEPSEEK_MODEL=deepseek-chat

# Enable when the deployed site uses HTTPS.
COOKIE_SECURE=false

# Optional: point to a persistent directory on the deployment host.
# RESUME_DATA_DIR=/path/to/resume-data
